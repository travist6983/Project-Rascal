<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- DEBUG. Generated from Info.plist by keeping every key identical and adding the ATS
	     exception below. If you change one of these files, change the other. Everything below
	     is a $() reference rather than a literal, so version and identity come from the target.

	     Authored rather than generated: GENERATE_INFOPLIST_FILE = YES cannot carry custom keys,
	     and this file lives beside the .xcodeproj because Rascal/Rascal/ is a synchronized
	     folder group where a stray plist is also copied as a resource. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- Only Release is ever uploaded, so this key does nothing here. It is present because
	     this file's contract is "every key identical to Info.plist plus the ATS exception",
	     and the one key that exists in one plist and not the other is how that contract stops
	     being true. See Info.plist for what it means. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations~iphone</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>

	<!-- Read with Bundle.main.object(forInfoDictionaryKey:). Values come from Config.xcconfig,
	     so no base URL and no UUID appears in Swift source. -->
	<!-- Debug only. The API is plain HTTP on localhost this phase and ATS blocks cleartext by
	     default, failing with -1022 in a way that reads like a server fault. This is the narrow
	     key: it permits cleartext to local/private addresses only, and is NOT
	     NSAllowsArbitraryLoads. Release (Info.plist) deliberately has no exception. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Shown verbatim in the system prompt the first time each is touched. Written as a
	     sentence a parent would actually understand — what is taken, and where it goes. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Add photos you have already taken to your child's archive. Nothing is read or uploaded unless you pick it.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save the original, full-quality video back to your photos. The archive keeps a smaller copy so it stays affordable to store for eighteen years.</string>
	<key>NSCameraUsageDescription</key>
	<string>Take a photo or video for today's prompt without leaving the app.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Record your child's voice for the archive — the entries you will be most glad to have in twenty years.</string>

	<!-- How the widget opens the app. Must stay identical to Info.plist: a plist cannot include
	     another one, so a key added to either has to be added to both. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.travisterry.childarchive.widget-deeplink</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>childarchive</string>
			</array>
		</dict>
	</array>

	<!-- Read with Bundle.main.object(forInfoDictionaryKey:). Values come from Config.xcconfig,
	     so no base URL and no UUID appears in Swift source. -->
	<key>API_BASE_URL</key>
	<string>$(API_BASE_URL)</string>
	<key>DEV_LOGIN_EMAIL</key>
	<string>$(DEV_LOGIN_EMAIL)</string>
	<key>DEV_CHILD_ID</key>
	<string>$(DEV_CHILD_ID)</string>
</dict>
</plist>
