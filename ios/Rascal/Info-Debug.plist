<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- DEBUG. Info.plist plus the ATS exception below and the two DEV_* keys at the bottom, and
	     nothing else may differ. If you change one of these files, change the other. Everything
	     below is a $() reference rather than a literal, so version and identity come from the
	     target.

	     Authored rather than generated: GENERATE_INFOPLIST_FILE = YES cannot carry custom keys,
	     and this file lives beside the .xcodeproj because Rascal/Rascal/ is a synchronized
	     folder group where a stray plist is also copied as a resource. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- Kept in step with Info.plist by hand. The two files differ only in App Transport
	     Security and the debug-only DEV_* keys, so a display name that drifts between them means
	     a Debug build on the phone wearing a different name from the TestFlight build beside
	     it. -->
	<key>CFBundleDisplayName</key>
	<string>Vellum</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- Only Release is ever uploaded, so this key does nothing here. It is present because
	     this file's contract is "every key identical to Info.plist plus the ATS exception",
	     and the one key that exists in one plist and not the other is how that contract stops
	     being true. See Info.plist for what it means. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Same key as Info.plist, same reason. Only Release is uploaded, so this does nothing
	     here — it is present because this file's contract is "every key identical plus the ATS
	     exception", and the key that exists in one plist and not the other is how that stops
	     being true. -->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>

	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations~iphone</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>

	<!-- Read with Bundle.main.object(forInfoDictionaryKey:). Values come from Config.xcconfig,
	     so no base URL and no UUID appears in Swift source. -->
	<!-- Debug only. The API is plain HTTP on localhost this phase and ATS blocks cleartext by
	     default, failing with -1022 in a way that reads like a server fault. This is the narrow
	     key: it permits cleartext to local/private addresses only, and is NOT
	     NSAllowsArbitraryLoads. Release (Info.plist) deliberately has no exception. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Shown verbatim in the system prompt the first time each is touched. Written as a
	     sentence a parent would actually understand — what is taken, and where it goes. -->
	<key>PHPhotoLibraryPreventAutomaticLimitedAccessAlert</key>
	<true/>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Vellum reads the dates on your photos and how many there are, so it can suggest months worth writing about. The pictures themselves stay on your phone — nothing is uploaded, and nothing is added to the archive unless you pick it.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save the original, full-quality video back to your photos. The archive keeps a smaller copy so it stays affordable to store for eighteen years.</string>
	<key>NSCameraUsageDescription</key>
	<string>Take a photo or video for today's prompt without leaving the app.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Record your child's voice for the archive — the entries you will be most glad to have in twenty years.</string>

	<!-- How the widget opens the app. Must stay identical to Info.plist: a plist cannot include
	     another one, so a key added to either has to be added to both. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.travisterry.childarchive.widget-deeplink</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>childarchive</string>
			</array>
		</dict>
		<!-- Google's OAuth callback. Unlike the deep-link scheme above, this one IS a $()
		     reference: it is the reversed client id, so pointing the app at a different Google
		     project has to change it, and a scheme that disagrees with GOOGLE_CLIENT_ID means
		     the browser closes onto nothing and the app never hears back. -->
		<dict>
			<key>CFBundleURLName</key>
			<string>com.travisterry.childarchive.google-oauth</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GOOGLE_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>

	<!-- Read with Bundle.main.object(forInfoDictionaryKey:). Values come from Config.xcconfig,
	     so no base URL and no UUID appears in Swift source. -->
	<key>API_BASE_URL</key>
	<string>$(API_BASE_URL)</string>
	<key>GOOGLE_CLIENT_ID</key>
	<string>$(GOOGLE_CLIENT_ID)</string>
	<key>GOOGLE_REVERSED_CLIENT_ID</key>
	<string>$(GOOGLE_REVERSED_CLIENT_ID)</string>
	<key>TERMS_URL</key>
	<string>$(TERMS_URL)</string>
	<key>PRIVACY_URL</key>
	<string>$(PRIVACY_URL)</string>

	<!-- **Debug only — these two are not in Info.plist, on purpose.** `AppConfig` reads them and
	     `AppConfig` is #if DEBUG, along with the rest of the dev-login path, so a Release build
	     has nothing that could read them. Keeping them out of the shipped bundle keeps the fixture
	     account's address and child id out of every App Store build. Every other key here still
	     has to exist in both files. -->
	<key>DEV_LOGIN_EMAIL</key>
	<string>$(DEV_LOGIN_EMAIL)</string>
	<key>DEV_CHILD_ID</key>
	<string>$(DEV_CHILD_ID)</string>
</dict>
</plist>
