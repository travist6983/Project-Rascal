<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Beside the .xcodeproj, not inside RascalWidget/, for the same reason the app's plist is:
	     RascalWidget/ is a synchronized folder group, so a plist placed there is also copied as
	     a resource and the build fails with "Multiple commands produce Info.plist".

	     One plist for both configurations. The app needs two because Debug relaxes App Transport
	     Security for a cleartext localhost API; the widget makes no network requests at all, so
	     there is nothing here for a Debug variant to differ about. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- **Literal, not `$(PRODUCT_NAME)`.** That variable resolves to this target's name,
	     "RascalWidget", which is what the widget gallery would have shown a parent. It reads
	     "Chronicle" now, matching the app, its debug variant and the share extension — the gallery
	     groups by the app's display name, so **all four** have to say the same thing **for this
	     key**. Since Aug 27, 2026 that qualifier matters: `CFBundleName` below is a different
	     string ("Pocket Chronicle"), and the four plists agree per key rather than on one name. -->
	<key>CFBundleDisplayName</key>
	<string>Chronicle</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Literal for the same reason as the display name above, and for a second one: iOS reads
	     `CFBundleName` when it writes its own sentences about a bundle, so `$(PRODUCT_NAME)` here
	     puts “RascalWidget” into system UI that the display name does not cover. -->
	<key>CFBundleName</key>
	<string>Pocket Chronicle</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.widgetkit-extension</string>
	</dict>
</dict>
</plist>
