// Vellum — iOS build configuration
//
// The app is Vellum as of Aug 12, 2026. `API_HOST` below still says `rascal-api.fly.dev` and
// must: that is the Fly app's name, an infrastructure identifier, and renaming it would mean a
// new app, a new deploy and a new certificate for nothing a parent ever sees.
//
//   cp ios/Rascal/Config.xcconfig.example ios/Rascal/Config.xcconfig
//
// The real Config.xcconfig is gitignored. It must live beside Rascal.xcodeproj — the project
// references it by a path relative to that directory. Every value the app needs at runtime
// comes from here and reaches Swift through Info.plist, so pointing the app at localhost, a
// LAN device, or a deployed API is a config change and never a code change.

// -- API ----------------------------------------------------------------------------------

// `//` starts a comment in xcconfig, so "https://host" written inline is silently truncated
// to "https:" — a host-less URL that fails at runtime looking like a server fault. $() is an
// empty variable that splits the slashes so they survive the parser. This is the one piece of
// this file that must not be "simplified".
//
// Debug and Release name different APIs here rather than being swapped by hand, because
// swapping by hand is how a build reaches a phone still aimed at localhost. This is the same
// split the Info.plist pair below already makes: Debug gets Info-Debug.plist and its cleartext
// ATS exception, Release gets neither. Cleartext and the exception that permits it are now
// decided one line apart, so they cannot drift out of agreement.
API_SCHEME               = https:$()/$()/
API_SCHEME[config=Debug] = http:$()/$()/

// Release is always the deployed API. Debug is the simulator, which shares the Mac's network
// stack — on a physical device localhost is the phone, so a device build wants the Mac's LAN
// address instead (and the API run with --host 0.0.0.0). Change the Debug line for that; the
// Release line is not the one to reach for.
//
// device on LAN : API_HOST[config=Debug] = 192.168.1.10:8000
//
// To run a debuggable build against the deployed API, leave both lines alone and switch the
// scheme instead: Product > Scheme > Edit Scheme > Run > Build Configuration > Release.
API_HOST                 = rascal-api.fly.dev
API_HOST[config=Debug]   = localhost:8000

API_BASE_URL = $(API_SCHEME)$(API_HOST)

// -- Development fixture account ----------------------------------------------------------

// Phase one authenticates with POST /v1/auth/dev-login, which is mounted only when the API
// runs with ENVIRONMENT=local and returns 404 in production. See docs/api-contract.md.
DEV_LOGIN_EMAIL = dev@rascal.local

// dev-login returns a user but NOT a child. Get one from GET /v1/children after logging in,
// or create one with POST /v1/children, then paste its id here.
DEV_CHILD_ID = 00000000-0000-0000-0000-000000000000

// -- App Transport Security ---------------------------------------------------------------

// The API is plain HTTP on localhost this phase, and ATS blocks that by default — the request
// fails with -1022, which reads like a server fault. NSAllowsLocalNetworking relaxes cleartext
// for local and private addresses only; it is not NSAllowsArbitraryLoads. Debug only, selected
// by swapping the whole Info.plist per configuration.
INFOPLIST_FILE = Info.plist
INFOPLIST_FILE[config=Debug] = Info-Debug.plist

// Custom Info.plist keys require an authored plist; INFOPLIST_KEY_* silently drops any key
// Apple does not already know. A target setting beats an xcconfig, so GENERATE_INFOPLIST_FILE
// is turned off in project.pbxproj rather than here.
GENERATE_INFOPLIST_FILE = NO

// -- Google sign-in (phase 55) -------------------------------------------------------------

// Not a secret: an iOS OAuth client is a *public* client — Google issues no client secret for
// it, which is exactly why the flow is PKCE — and this string ships inside every copy of the
// app. It is here rather than hardcoded for the same reason API_HOST is: pointing the app at a
// different Google project is a config change, never a code change.
GOOGLE_CLIENT_ID = 22574619282-vs702oo01a8vne7tsbc6h3ilk6a0sje6.apps.googleusercontent.com

// The OAuth callback comes back on the *reversed* client id as a custom URL scheme, so this
// has to be registered in Info.plist's CFBundleURLSchemes. It is derived from the value above
// and must be kept in step with it — Google's own downloaded plist lists both for this reason.
// No "//" appears in either value, so neither trips the xcconfig comment parser the API_SCHEME
// note above describes.
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.22574619282-vs702oo01a8vne7tsbc6h3ilk6a0sje6
