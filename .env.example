# Copy to .env at the repo root. `make` loads it for every target.
# These defaults line up with docker-compose.yml and are safe for local development only.

ENVIRONMENT=local

# docker-compose publishes Postgres 16 on 5433 to avoid a local install on 5432. If 5433 is
# already taken on your machine — another project's compose stack is the usual culprit, and
# the symptom is a container stuck in `Created` — change both of these to the same free port.
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://rascal:rascal@localhost:5433/rascal

# Alembic only. In production this is Neon's *direct* endpoint while DATABASE_URL is the
# *pooled* one — a migration through a transaction-mode pooler fails confusingly. There is
# no pooler locally, so leave it unset and Alembic falls back to DATABASE_URL.
# DIRECT_DATABASE_URL=

# 32 bytes, because anything shorter trips PyJWT's InsecureKeyLengthWarning on every call.
# Generate the production value with `openssl rand -hex 32` — see docs/DEPLOY.md section 3.
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Object storage — Tigris, which is S3-compatible. See docs/tigris-setup.md.
# Tests still stub this with moto and presigning is offline, so the placeholders below are
# enough to run the suite; a real upload needs real values.
S3_BUCKET=rascal-media-dev
# Tigris is globally distributed and has no AWS-style regions. Leaving a real region here
# produces a signature error that reads like a credentials problem.
S3_REGION=auto
# https://t3.storage.dev from a laptop or CI; https://fly.storage.tigris.dev from inside Fly.
# Unset means real AWS, which is how this ran before Tigris.
S3_ENDPOINT_URL=https://t3.storage.dev
# Tigris keys look like tid_… / tsec_…. `tigris access-keys create` prints the secret once.
# A new key has NO permissions until you run:
#   tigris access-keys assign <id> --bucket <bucket> --role Editor
AWS_ACCESS_KEY_ID=local-dev-access-key
AWS_SECRET_ACCESS_KEY=local-dev-secret-key

# The `aud` claim every Apple identity token is checked against.
APPLE_BUNDLE_ID=com.travisterry.childarchive
